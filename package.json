{
  "name": "@universal/playwright-framework",
  "version": "1.0.0",
  "description": "Reviewed Cucumber + Playwright execution adapters, runtime login and input preparation for ReleaseReady",
  "main": "dist/cucumber/src/index.js",
  "types": "dist/cucumber/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cucumber/src/index.d.ts",
      "default": "./dist/cucumber/src/index.js"
    },
    "./adapter/v1": {
      "types": "./dist/cucumber/src/adapter/v1.d.ts",
      "default": "./dist/cucumber/src/adapter/v1.js"
    },
    "./data-references/v1": {
      "types": "./dist/cucumber/src/input-preparation/data-references.d.ts",
      "default": "./dist/cucumber/src/input-preparation/data-references.js"
    },
    "./adapter/v2": {
      "types": "./dist/cucumber/src/adapter/v2.d.ts",
      "default": "./dist/cucumber/src/adapter/v2.js"
    },
    "./runtime-login/v1": {
      "types": "./dist/cucumber/src/runtime-login/v1.d.ts",
      "default": "./dist/cucumber/src/runtime-login/v1.js"
    },
    "./adapter/imported-v1": {
      "types": "./dist/cucumber/src/adapter/imported-v1.d.ts",
      "default": "./dist/cucumber/src/adapter/imported-v1.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist/cucumber && npm run build:cucumber",
    "build:cucumber": "tsc --project tsconfig.cucumber.json",
    "test:input-preparation": "npm run build:cucumber && cucumber-js --config cucumber-input-preparation.json && node --test dist/cucumber/scripts/data-references.test.js dist/cucumber/scripts/runtime-login.test.js dist/cucumber/scripts/reference-only-preparation.test.js",
    "test:customer-login": "npm run build:cucumber && node --test --test-concurrency=1 dist/cucumber/scripts/partay-login.test.js dist/cucumber/scripts/runtime-login-cleanup.test.js dist/cucumber/scripts/runtime-login-ordering.test.js dist/cucumber/scripts/shared-helpers.test.js",
    "test:customer-login-ui": "npm run build:cucumber && cucumber-js --config cucumber-login-ui.json",
    "verify:partay-login": "npm run build:cucumber && node dist/cucumber/scripts/verify-partay-login.js",
    "test:validation": "npm run build:cucumber && node --test dist/cucumber/scripts/feature-validation.test.js",
    "test:features": "npm run build:cucumber && cucumber-js --config cucumber.json",
    "test:execution": "npm run build:cucumber && node --test dist/cucumber/scripts/windows-taskkill.test.js dist/cucumber/scripts/execution-adapter.test.js dist/cucumber/scripts/teardown-evidence.test.js dist/cucumber/scripts/guarded-route.test.js && cucumber-js --config cucumber-retry-regression.json",
    "test:reporting": "npm run build:cucumber && node --test dist/cucumber/scripts/reporting.test.js && cucumber-js --config cucumber-reporting.json",
    "test:adapter": "npm run build:cucumber && node --test dist/cucumber/scripts/adapter-contract.test.js && cucumber-js --config cucumber-adapter.json",
    "review:revision": "npm run build && node dist/cucumber/scripts/reviewed-revision.js",
    "execute:synthetic": "npm run build:cucumber && node dist/cucumber/src/execution/cli.js",
    "test:features:regression": "npm run test:input-preparation && npm run test:customer-login && npm run test:validation && npm run test:features && npm run test:execution && node --test dist/cucumber/scripts/cucumber-timeouts.test.js && npm run test:reporting && npm run test:adapter",
    "clean": "rimraf dist reports/*.json test-results",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "npm run build",
    "check:typescript": "npm run build && node dist/cucumber/scripts/check-typescript-source-policy.js",
    "test:typescript-source-policy": "npm run check:typescript && node --test dist/cucumber/scripts/typescript-source-policy.test.js",
    "test:login-inspection": "npm run build:cucumber && node --test --test-concurrency=1 dist/cucumber/scripts/login-inspection.test.js dist/cucumber/scripts/paused-work-clock.test.js dist/cucumber/scripts/login-inspection-cancellation.test.js",
    "inspect:partay-login": "npm run build:cucumber && node dist/cucumber/scripts/inspect-partay-login.js",
    "test:authentication-only": "npm run build:cucumber && node --test dist/cucumber/scripts/authentication-only.test.js",
    "test:owned-local": "npm run build:cucumber && node --test dist/cucumber/scripts/owned-local-adapter.test.js",
    "test:runtime-login-entry": "npm run build && node --test --test-concurrency=1 dist/cucumber/scripts/runtime-login-entry.test.js dist/cucumber/scripts/runtime-login-package.test.js",
    "test:agentic-rehearsal": "npm run build:cucumber && node --test dist/cucumber/scripts/agentic-rehearsal.test.js dist/cucumber/scripts/reuse-readiness.test.js",
    "starter": "npm run build:cucumber && node dist/cucumber/scripts/private-starter.js",
    "test:private-starter": "npm run build:cucumber && node --test dist/cucumber/scripts/private-starter.test.js",
    "verify:private-starter": "npm run build:cucumber && VERIFY_PRIVATE_STARTER=1 node --test dist/cucumber/scripts/private-starter-artifact.test.js"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "e2e",
    "testing",
    "typescript",
    "releaseready"
  ],
  "author": "Universal Testing Framework Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/releaseready/universal-playwright-framework.git"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-playwright": "^0.18.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/cucumber-expressions": "19.0.0",
    "@cucumber/gherkin": "38.0.0",
    "@playwright/test": "1.65.1",
    "playwright-core": "1.65.1",
    "zod": "4.6.7"
  },
  "files": [
    "dist/cucumber",
    "src",
    "fixtures",
    "features/execution",
    "features/support/step-timeout.ts",
    "cucumber-execution.json",
    "tsconfig.json",
    "tsconfig.cucumber.json",
    "docs/local-adapter-contract.md",
    "README.md",
    "docs/input-preparation-contract.md",
    "docs/partay-login.md",
    "docs/runtime-login-entry.md",
    "docs/windows-taskkill.md"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "@cucumber/cucumber": {
      "glob": "14.0.4"
    },
    "minimatch@>=9": "11.0.5"
  }
}
