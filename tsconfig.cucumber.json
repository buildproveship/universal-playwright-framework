{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/cucumber",
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "fixtures/**/*.ts",
    "features/execution/**/*.ts",
    "features/adapter/**/*.ts",
    "features/reporting/**/*.ts",
    "features/input-preparation/**/*.ts",
    "features/support/**/*.ts",
    "features/steps/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
